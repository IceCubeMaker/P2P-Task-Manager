CREATE TABLE IF NOT EXISTS groups (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    creatorPeerId TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    inviteCode TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS group_members (
    groupId TEXT NOT NULL,
    peerId TEXT NOT NULL,
    displayName TEXT NOT NULL,
    deviceName TEXT NOT NULL,
    avatarColor INTEGER NOT NULL DEFAULT 0,
    joinedAt INTEGER NOT NULL,
    lastSeenAt INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (groupId, peerId),
    FOREIGN KEY (groupId) REFERENCES groups(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_gm_peer ON group_members(peerId);

insertGroup:
INSERT OR REPLACE INTO groups(id, name, creatorPeerId, createdAt, inviteCode, color)
VALUES (:id, :name, :creatorPeerId, :createdAt, :inviteCode, :color);

getAllGroups:
SELECT * FROM groups ORDER BY createdAt DESC;

getGroupById:
SELECT * FROM groups WHERE id = :id;

updateGroupName:
UPDATE groups SET name = :name WHERE id = :id;

deleteGroup:
DELETE FROM groups WHERE id = :id;

insertMember:
INSERT OR REPLACE INTO group_members(groupId, peerId, displayName, deviceName, avatarColor, joinedAt, lastSeenAt)
VALUES (:groupId, :peerId, :displayName, :deviceName, :avatarColor, :joinedAt, :lastSeenAt);

getMembersForGroup:
SELECT * FROM group_members WHERE groupId = :groupId ORDER BY joinedAt ASC;

getMemberByPeer:
SELECT * FROM group_members WHERE peerId = :peerId;

getGroupsForPeer:
SELECT g.id FROM groups g
JOIN group_members gm ON g.id = gm.groupId
WHERE gm.peerId = :peerId;

updateLastSeen:
UPDATE group_members SET lastSeenAt = :lastSeen WHERE groupId = :groupId AND peerId = :peerId;

getAllGroupIds:
SELECT id FROM groups;
